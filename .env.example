# X Music Bot — Environment Variables
# Copy this file to .env locally, or set these as environment variables on Render

# Buffer API (get from https://publish.buffer.com/settings/api)
BUFFER_API_KEY=your_buffer_api_key_here
BUFFER_CHANNEL_ID=your_buffer_channel_id_here

# Groq LLM (get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
